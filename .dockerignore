epcoro-api/.phpunit.cache

# --- Prueba local (no va a la imagen) ---
docker-compose.local.yml

# --- Frontend: dependencias y build previo (se reconstruye en la etapa web) ---
epcoro-web/node_modules
epcoro-web/dist
epcoro-web/.env
epcoro-web/.env.local
epcoro-web/.vscode
