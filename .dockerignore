# SINCHI WAYRA - que NO entra en el contexto de build de Docker.
#
# Ojo: .gitignore NO afecta a Docker. Sin este archivo, un `COPY sinchy-api/ .`
# copiaria el .env real (con secretos), vendor/ y node_modules/ a la imagen.

# --- Git y metadatos ---
.git
.gitignore
.gitattributes

# --- Documentacion y material de desarrollo (no van a la imagen) ---
docs
auxiliar
*.docx
manual.docx
usuarios_prueba.txt
notas1.txt
notas_figma.txt
pasos.txt
pasos_otra_maquina.txt
instrucciones.txt
plan_pruebas.md
prompt.txt
puesta_produccion.txt
README.md
RETOMAR.md
sinchy.code-workspace

# --- Backend: dependencias, entorno y artefactos locales ---
sinchy-api/vendor
sinchy-api/.env
sinchy-api/.env.backup
sinchy-api/.env.production
sinchy-api/.env.development
sinchy-api/node_modules
sinchy-api/public/build
sinchy-api/public/hot
sinchy-api/public/storage
sinchy-api/storage/framework/cache/data
sinchy-api/storage/framework/sessions
sinchy-api/storage/framework/views
sinchy-api/storage/logs
sinchy-api/.phpunit.result.cache
sinchy-api/.phpunit.cache

# --- Prueba local (no va a la imagen) ---
docker-compose.local.yml

# --- Frontend: dependencias y build previo (se reconstruye en la etapa web) ---
sinchy-web/node_modules
sinchy-web/dist
sinchy-web/.env
sinchy-web/.env.local
sinchy-web/.vscode
