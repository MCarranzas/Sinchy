# SINCHI WAYRA - variables para docker-compose.prod.yml / Coolify.
#
# Copia este archivo a .env.prod (NO se sube al repo) y completa los valores:
#   cp deploy_vps/.env.prod.example .env.prod
#
# En Coolify NO uses este archivo: pega cada variable en la pestana
# "Environment Variables" del recurso (ver deploy_vps/despliegue_vps.md).

APP_NAME=SINCHI WAYRA

# Genera la clave UNA sola vez, desde tu maquina:
#   cd epcoro-api && php artisan key:generate --show
# Copia el valor completo (empieza con "base64:"). No la regeneres despues:
# invalidaria todas las sesiones.
APP_KEY=base64:REEMPLAZA_ESTA_CLAVE

# Dominio publico con HTTPS.
APP_URL=https://epcoro.tudominio.com
# El mismo host, SIN https:// y sin puerto (para Sanctum / cookies).
SANCTUM_DOMAIN=epcoro.tudominio.com

# PostgreSQL. Usa una contrasena fuerte y distinta a la de desarrollo.
DB_DATABASE=epcoro
DB_USERNAME=epcoro
DB_PASSWORD=cambia_esta_clave_por_una_fuerte

# Primer arranque: pon SEED=1 para sembrar los datos base (Anexo F) y
# DEMO_SEED=1 si ademas quieres los datos de demostracion. Luego vuelve a "0"
# (o borra estas lineas) para no re-sembrar en cada reinicio.
SEED=0
DEMO_SEED=0
