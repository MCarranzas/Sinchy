includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5

    paths:
        - app
        - routes
        - database
        - tests

    # Laravel declara `protected $command;` en Seeder con un `@var Command`, pero
    # la propiedad no tiene tipo y solo se inicializa si se pasa el comando
    # (Laravel mismo la consulta con `isset()`). Al analizar fielmente, PHPStan
    # toma ese `@var` como certeza y se niega a aceptar tanto `isset()` como
    # `?->`, obligando a un acceso que revienta si el seeder se invoca sin
    # consola. treatPhpDocTypesAsCertain: false es justamente la opcion que el
    # propio error sugiere: no silencia ningun error, solo deja de confiar en
    # anotaciones de vendor que se sabe incorrectas.
    treatPhpDocTypesAsCertain: false

    # Las rutas ignoradas de abajo apuntan a un constructo que el analizador
    # no puede seguir (la sintaxis de PostgreSQL en las migraciones).
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Las migraciones crean el ENUM liquidacion_estado con DB::statement
        # porque la sintaxis de PostgreSQL no tiene equivalente en el analizador.
        -
            identifier: staticMethod.notFound
            path: database/migrations