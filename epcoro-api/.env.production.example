# =============================================================================
#  SINCHI WAYRA - API - variables de entorno de PRODUCCION (plantilla)
# =============================================================================
#  Copiar a `.env` en el servidor y completar. NUNCA commitear el `.env`
#  real. Este archivo es la plantilla de la FASE 11.7: a diferencia de
#  `.env.example` (pensado para desarrollo local), aqui los valores por
#  defecto son los SEGUROS para produccion. Verificar con:
#
#      php artisan sinchiwayra:revisar-produccion
#
# =============================================================================

APP_NAME="SINCHI WAYRA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sinchiwayra.example.gob.bo

# Hora de Bolivia: las liquidaciones y los reportes se registran aqui.
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_BO

APP_MAINTENANCE_DRIVER=file
# Dejar la tienda de mantenimiento en base de datos para que varios nodos
# respeten el modo mantenimiento a la vez.
APP_MAINTENANCE_STORE=database

# Subir el costo de bcrypt si la maquina lo soporta (12 es el minimo sano).
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
# La auditoria de acciones sensibles (11.5) va a su propio archivo.
LOG_AUDITORIA_DAYS=180

# PostgreSQL 17. La contrasena NO puede quedar vacia (lo verifica el
# comando de revision): en produccion viene del gestor de secretos o de una
# variable protegida del servicio, nunca de este archivo versionado.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=epcoro
DB_USERNAME=epcoro
DB_PASSWORD=

# Sesion: cookie solo por HTTPS, cifrada y con caducidad razonable.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@sinchiwayra.example.gob.bo"
MAIL_FROM_NAME="${APP_NAME}"

# --- CORS (ver config/cors.php) ---
# Solo el dominio real de la SPA. Sin localhost.
CORS_ALLOWED_ORIGINS=https://sinchiwayra.example.gob.bo

# --- Sanctum (SPA con cookie de sesion) ---
# Solo dominios de produccion. Sin localhost/127.0.0.1.
SANCTUM_STATEFUL_DOMAINS=sinchiwayra.example.gob.bo

# --- Proxies de confianza (IP del cliente en X-Forwarded-For) ---
# La IP o red de Nginx, NUNCA '*'. La IP real del cliente llega en
# X-Forwarded-For (Nginx debe enviarla con proxy_set_header) y aqui se indica
# quien esta autorizado a ponerla; sino $request->ip() sera la de Nginx.
TRUST_PROXIES=

# URL de la SPA a la que vuelve el frontend tras el login.
FRONTEND_URL=https://sinchiwayra.example.gob.bo

# --- Respaldos (FASE 11.6) ---
# Apuntar a un volumen fuera del arbol de la aplicacion.
RESPALDO_DIRECTORIO=/var/backups/sinchiwayra
RESPALDO_DIAS_RETENCION=30
# Ruta al binario de pg_dump de la version del servidor de PostgreSQL.
PG_DUMP_PATH=/usr/bin/pg_dump
