{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": false,
        "concat_space": {
            "spacing": "none"
        },
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "phpdoc_align": false
    },
    "exclude": [
        "bootstrap",
        "storage",
        "vendor"
    ]
}