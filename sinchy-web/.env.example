# Variables de entorno del frontend (FASE 11.7).
#
# Solo las variables con prefijo VITE_ llegan al codigo compilado. Copie este
# archivo a `.env.development` (o `.env.local`, que no se versiona) y ajuste
# si su backend no corre en el puerto por defecto.
#
# OJO: VITE_API_PROXY_TARGET solo lo usa el SERVIDOR DE DESARROLLO de Vite.
# En produccion el frontend es estatico y es Nginx quien enruta /api y
# /sanctum al backend, asi que no hay que compilar con ninguna URL: por eso la
# app llama siempre a rutas relativas.

# Destino del proxy de desarrollo para /api y /sanctum.
VITE_API_PROXY_TARGET=http://localhost:8000
