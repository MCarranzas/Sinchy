# =============================================================================
#  SINCHI WAYRA - API - variables para Alwaysdata Free
# =============================================================================
#  Copiar a ~/sinchy-api/.env en el servidor y reemplazar:
#    CUENTA            -> nombre de la cuenta de Alwaysdata
#    CAMBIAR_ESTA_CLAVE -> contrasena real de PostgreSQL
#
#  No subir este archivo con secretos reales al repositorio.
# =============================================================================

APP_NAME="SINCHI WAYRA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CUENTA.alwaysdata.net

APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_BO

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_AUDITORIA_DAYS=180

# PostgreSQL 17 en Alwaysdata. Los nombres completos llevan el prefijo de la
# cuenta y se ven en Databases > PostgreSQL del panel.
DB_CONNECTION=pgsql
DB_HOST=postgresql-CUENTA.alwaysdata.net
DB_PORT=5432
DB_DATABASE=CUENTA_sinchy
DB_USERNAME=CUENTA_sinchy
DB_PASSWORD="CAMBIAR_ESTA_CLAVE"

# Cookies de sesion solo por HTTPS. SESSION_DOMAIN debe quedar en null para
# que la cookie pertenezca al host del sitio (CUENTA.alwaysdata.net).
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@CUENTA.alwaysdata.net"
MAIL_FROM_NAME="${APP_NAME}"

# Mismo origen: no hay CORS real, pero se declara el host exacto.
CORS_ALLOWED_ORIGINS=https://CUENTA.alwaysdata.net

# Sin esquema y sin barra final. Debe incluir el host exacto.
SANCTUM_STATEFUL_DOMAINS=CUENTA.alwaysdata.net

# En Alwaysdata el sitio esta detras de Apache. Dejar vacio evita confiar en
# cabeceras X-Forwarded-For de cualquiera. Si soporte indica un proxy concreto,
# poner aqui su IP.
TRUST_PROXIES=

FRONTEND_URL=https://CUENTA.alwaysdata.net

# Respaldos: crear el directorio con mkdir -p ~/backups/sinchy.
RESPALDO_DIRECTORIO=/home/CUENTA/backups/sinchy
RESPALDO_DIAS_RETENCION=14
# Verificar con: which pg_dump
PG_DUMP_PATH=pg_dump
