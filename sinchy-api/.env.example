APP_NAME="SINCHI WAYRA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Las liquidaciones se registran en hora de Bolivia. Sin esto, config/app.php
# cae a UTC y las fechas del formulario no cuadran con las de la base.
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_BO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 17. NO usar sqlite: las migraciones crean el ENUM
# liquidacion_estado con DB::statement, que es sintaxis de PostgreSQL.
# DB_DATABASE para los tests va aparte: ver phpunit.xml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sinchy
DB_USERNAME=sinchy
# Solo desarrollo. En produccion va en el gestor de secretos.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- CORS (ver config/cors.php) ---
# Orígenes permitidos separados por coma. El primero es el de Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Sanctum (SPA con cookie de sesión) ---
# Debe incluir el backend además del frontend. Sanctum solo inicia la sesión si
# el Referer/Origin de la petición está en esta lista; si falta el backend, el
# login responde 500 con "Session store not set on request".
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000

# --- Proxies de confianza (IP del cliente en X-Forwarded-For) ---
# '*' confia en todos los proxies (dev con Vite --host). En produccion usar la
# IP/red de Nginx, nunca '*'.
TRUST_PROXIES=*

# URL de la SPA a la que vuelve el frontend tras el login.
FRONTEND_URL=http://localhost:5173
