# SINCHI WAYRA - Nginx de produccion (un solo dominio: SPA + API).
#
# El puerto lo inyecta el proveedor en la variable PORT; start.sh reemplaza
# ${PORT} con envsubst antes de arrancar Nginx. Por eso este archivo NO se llama
# *.conf (nginx no debe cargarlo tal cual, con el literal ${PORT}).
#
# La SPA es la raiz; /api, /sanctum y /up van a Laravel por FastCGI. Asi el
# navegador ve un solo origen y la cookie de sesion de Sanctum viaja sin
# problemas.

server {
    listen ${PORT};
    server_name _;

    root /var/www/web;                 # dist/ compilado de la SPA
    index index.html;

    client_max_body_size 12m;

    # --- API, CSRF de Sanctum y health check -> Laravel (PHP-FPM) ---
    location ~ ^/(api|sanctum|up)(/|$) {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;

        fastcgi_param SCRIPT_FILENAME /var/www/api/public/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param DOCUMENT_ROOT   /var/www/api/public;
        fastcgi_param REQUEST_URI     $request_uri;
        fastcgi_param HTTPS           $https if_not_empty;

        # El proxy TLS del proveedor termina el HTTPS y manda la cabecera.
        # Reenviarla es lo que hace que Laravel ($request->isSecure()) genere
        # URLs https y acepte la cookie SESSION_SECURE_COOKIE=true.
        # if_not_empty: si el proxy no manda la cabecera, NO se reenvia (en vez
        # de enviarla vacia). Una X-Forwarded-Host vacia hace que Symfony
        # (Request::getPort) acceda a $host[0] sobre "" y devuelva 500.
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto if_not_empty;
        fastcgi_param HTTP_X_FORWARDED_FOR   $http_x_forwarded_for   if_not_empty;
        fastcgi_param HTTP_X_FORWARDED_HOST  $http_x_forwarded_host  if_not_empty;

        fastcgi_read_timeout 120s;
    }

    # --- Estaticos con hash en el nombre: cache agresiva ---
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # --- SPA con historial HTML5: todo lo demas cae en index.html ---
    location / {
        try_files $uri /index.html;
    }
}
