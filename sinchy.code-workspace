{
  "folders": [
    { "path": "." },
    { "name": "sinchy-api (Laravel 13)", "path": "sinchy-api" },
    { "name": "sinchy-web (Vue 3)", "path": "sinchy-web" }
  ],
  "settings": {
    "files.eol": "\r\n",
    "files.encoding": "utf8",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [100],
    "[php]": {
      "editor.tabSize": 4,
      "editor.insertSpaces": true
    },
    "[javascript]": { "editor.tabSize": 2 },
    "[typescript]": { "editor.tabSize": 2 },
    "[vue]": { "editor.tabSize": 2 },
    "[json]": { "editor.tabSize": 2 },
    "[jsonc]": { "editor.tabSize": 2 },
    "files.associations": {
      "*.env.example": "dotenv",
      "*.drawio": "xml"
    },
    "search.exclude": {
      "**/vendor": true,
      "**/node_modules": true,
      "**/storage/framework": true
    },
    "files.exclude": {
      "**/.env": true
    }
  },
  "extensions": {
    "recommendations": [
      "brian0312.vscode-php-intelephense",
      "onecentlin.laravel-blade",
      "EditorConfig.EditorConfig",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "Vue.volar",
      "bradlc.vscode-tailwindcss",
      "EditorConfig.EditorConfig",
      "mikestead.dotenv",
      "mrmlnc.vscode-duplicate"
    ]
  }
}